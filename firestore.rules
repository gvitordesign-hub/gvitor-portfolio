rules_version = '2';

// Regras do Firestore do portfólio GVITOR.
// - Qualquer visitante pode LER os projetos (o site é público).
// - Somente a conta do dono pode CRIAR, EDITAR ou APAGAR.
//
// ANTES DE PUBLICAR: troque SEU_UID_AQUI pelo UID da sua conta
// (Firebase Console → Authentication → Users → coluna "UID de usuário").
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.uid == 'Xo3seegFtUNMlIeDjJshtFGJCJh2';
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Qualquer outra coleção: fechada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
